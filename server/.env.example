# Copy to server/.env and fill in. .env is gitignored and must stay that way:
# the token in it is the only thing standing between the network and whatever
# your backend can reach.

# ---------------------------------------------------------------------------
# The lock
# ---------------------------------------------------------------------------

# Required. The same string goes into the watch app (watch/local.properties).
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ASK_TOKEN=

# ---------------------------------------------------------------------------
# The listener
# ---------------------------------------------------------------------------

ASK_PORT=8787

# 0.0.0.0 so the watch can reach it across the LAN. Use 127.0.0.1 while you are
# only testing from this machine.
ASK_HOST=0.0.0.0

# Give up on an answer after this long (ms).
ASK_TIMEOUT_MS=300000

# Questions are dictated out loud and end up in a log file, so this is off.
# Turn it on only while debugging.
ASK_LOG_QUESTIONS=false

# What the model is told about where its answer is going. The default asks for
# two or three sentences, because a 45mm screen is the real constraint.
# ASK_SYSTEM_PROMPT=Answer in at most two short sentences.

# ---------------------------------------------------------------------------
# Which backend answers: claude-cli | http | echo
# ---------------------------------------------------------------------------

ASK_ADAPTER=claude-cli

# --- claude-cli: headless Claude Code on this machine, $0 in API calls -------

# Full path if `claude` is not on PATH.
ASK_CLAUDE_BIN=claude

# The directory the CLI runs in. This is the scope of what it can see, so point
# it at the project you actually want to ask about.
ASK_WORK_DIR=/path/to/your/project

# Extra roots it may read, comma separated. Leave empty unless you need them.
ASK_ADD_DIRS=

# Optional model override, e.g. claude-sonnet-4-5.
ASK_CLAUDE_MODEL=

# A headless session cannot answer a permission prompt, so "default" means the
# CLI answers from what it can read without asking and declines the rest.
# Widening this to bypassPermissions gives whoever holds the token a shell on
# this machine. Read the security section of the README before you do.
ASK_CLAUDE_PERMISSION_MODE=default

# Narrower than a permission mode: an explicit tool allowlist, e.g.
# "Read,Grep,Glob,Bash(git log:*)".
ASK_CLAUDE_ALLOWED_TOOLS=

# --- http: any OpenAI-compatible /chat/completions endpoint ------------------

# The root that has /chat/completions under it.
#   OpenAI     https://api.openai.com/v1
#   Ollama     http://127.0.0.1:11434/v1
#   LM Studio  http://127.0.0.1:1234/v1
ASK_HTTP_BASE_URL=
ASK_HTTP_API_KEY=
ASK_HTTP_MODEL=
ASK_HTTP_MAX_TOKENS=512
ASK_HTTP_TEMPERATURE=
